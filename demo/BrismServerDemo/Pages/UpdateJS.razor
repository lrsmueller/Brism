@page "/updateJS"

@using Brism
@using System.Diagnostics

<PageTitle>Code Example Update - Brism Umanaged Update</PageTitle>


<h1>Code Update - Brism Umanaged Update</h1>

<div class="mb-4">
    <h3>Sample Code to Update</h3>
	<button class="btn btn-primary" @onclick="UpdateCode">Update Code</button>
	<CodeBlock EnableCodeUpdates=true Code=@Code Language="CodeLanguage.CSharp" @ref="jsCode" />
</div>

@code {

	private CodeBlock? jsCode { get; set; }

	private bool codeToggle = false;

	private string Code => codeToggle ? @"
		// Records
		public record Person(string FirstName, string LastName, int Age);

		// Pattern matching
		public static string GetDisplayName(Person person) => person switch
		{
			{ FirstName: ""John"", LastName: ""Doe"" } => ""JD"",
			{ FirstName: var first, LastName: var last } => $""{first[0]}{last[0]}"",
			null => ""Unknown""
		};

		// LINQ and Collections
		public class DataProcessor
		{
			public IEnumerable<int> ProcessNumbers(IEnumerable<int> numbers)
			{
				return numbers
					.Where(n => n > 0)
					.OrderBy(n => n)
					.Select(n => n * 2);
			}
		}"
		:@"
		// Updated Code Records
		public record UpdatedPerson(string FirstName, string LastName, DateTime Birthday);
		";

	private Stopwatch jsTimer = new();


	public void UpdateCode(MouseEventArgs args)
	{
		codeToggle = !codeToggle;
		Debug.WriteLine($"Started {nameof(UpdateJS)}");
		jsCode.Timer.Start();
		StateHasChanged();
		
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();
		jsTimer.Start();
	}

	protected override void OnAfterRender(bool firstRender)
	{
		base.OnAfterRender(firstRender);
		jsTimer.Stop();
		Debug.WriteLine($"Page {nameof(UpdateJS)} Timer: {jsTimer.ElapsedTicks}");
	}
}