@page "/updateKey"

@using Brism
@using System.Diagnostics

<PageTitle>Code Example Update - Brism @@Key Update</PageTitle>


<h1>Code Example Update - Brism @@Key Update</h1>

<div class="mb-4">
    <h3>Sample Code to Update</h3>
	<button class="btn btn-primary" @onclick="UpdateCode">Update Code</button>
	<CodeBlock Code=@Code Language="CodeLanguage.CSharp" @key=CodeKey @ref="keyCode" />
</div>

@code {

	private CodeBlock? keyCode { get; set; }
	private int CodeKey => codeToggle ? 0 : 1;
	private bool codeToggle = false;

	private string Code => codeToggle ? @"
		// Records
		public record Person(string FirstName, string LastName, int Age);

		// Pattern matching
		public static string GetDisplayName(Person person) => person switch
		{
			{ FirstName: ""John"", LastName: ""Doe"" } => ""JD"",
			{ FirstName: var first, LastName: var last } => $""{first[0]}{last[0]}"",
			null => ""Unknown""
		};

		// LINQ and Collections
		public class DataProcessor
		{
			public IEnumerable<int> ProcessNumbers(IEnumerable<int> numbers)
			{
				return numbers
					.Where(n => n > 0)
					.OrderBy(n => n)
					.Select(n => n * 2);
			}
		}"
		:@"
		// Updated Code Records
		public record UpdatedPerson(string FirstName, string LastName, DateTime Birthday);
		";
	private Stopwatch keyTimer = new();

	public void UpdateCode(MouseEventArgs args)
	{
		codeToggle = !codeToggle;
		Debug.WriteLine($"Started Update {nameof(UpdateKey)}");
		keyTimer.Start();
		StateHasChanged();
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();
		keyTimer.Start();
	}

	protected override void OnAfterRender(bool firstRender)
	{
		base.OnAfterRender(firstRender);
		keyTimer.Stop();
		Debug.WriteLine($"Page {nameof(UpdateKey)} Timer: {keyTimer.ElapsedTicks}");
	}
}